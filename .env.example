# Copy to .env and override if any of the pinned image tags below stop
# resolving (registries occasionally prune old tags -- this already happened
# once with bitnami/kafka and once with debezium/connect while building this
# demo). Find current tags at:
#   https://hub.docker.com/r/apache/kafka/tags
#   https://quay.io/repository/debezium/connect?tab=tags   (Debezium's authoritative registry -- the docker.io/debezium mirror is unreliable)
#   https://hub.docker.com/_/postgres/tags
#
# POSTGRES_IMAGE=postgres:16
# KAFKA_IMAGE=apache/kafka:3.8.0
# DEBEZIUM_IMAGE=quay.io/debezium/connect:latest
